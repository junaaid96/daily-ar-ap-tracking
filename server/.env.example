# Neon connection string (Dashboard → Connect). Use the pooled host for serverless deploys.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
PORT=4000
# Comma-separated list of allowed browser origins (leave empty to allow any in dev)
CORS_ORIGIN=http://localhost:5173
# Run pending SQL migrations on boot
AUTO_MIGRATE=true
